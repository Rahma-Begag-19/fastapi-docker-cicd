
{
  "uid": "docker-containers",
  "title": "Docker Container Monitoring",
  "tags": ["devops", "docker", "cadvisor", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Usage per Container",
      "description": "CPU consumption expressed as a percentage of one CPU core.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{image!=\"\",name!=\"\"}[5m])) * 100",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory Usage per Container",
      "description": "Container memory working set in MiB.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "mebibytes", "min": 0},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (container_memory_working_set_bytes{image!=\"\",name!=\"\"}) / 1024 / 1024",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network Receive Rate",
      "description": "Incoming network traffic in bytes per second.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "Bps", "min": 0},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{image!=\"\",name!=\"\"}[5m]))",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network Transmit Rate",
      "description": "Outgoing network traffic in bytes per second.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "Bps", "min": 0},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{image!=\"\",name!=\"\"}[5m]))",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Filesystem Usage per Container",
      "description": "Reported container filesystem usage in MiB. Availability depends on the runtime.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "mebibytes", "min": 0},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (container_fs_usage_bytes{image!=\"\",name!=\"\"}) / 1024 / 1024",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container Memory Limits",
      "description": "Reported memory limit in MiB. Large host-level limits may reflect available host memory rather than an explicit container limit.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "mebibytes", "min": 0},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (name) (container_spec_memory_limit_bytes{image!=\"\",name!=\"\"}) / 1024 / 1024",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    }
  ]
}
